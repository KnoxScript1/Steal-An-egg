--==================================================
-- INVISIBILITY
--==================================================

local invisible = false

local function setInvisible(state)

	invisible = state

	local character = player.Character

	if character then

		for _, object in ipairs(character:GetDescendants()) do

			if object:IsA("BasePart") then
				object.LocalTransparencyModifier = state and 1 or 0

			elseif object:IsA("Decal") then
				object.Transparency = state and 1 or 0

			elseif object:IsA("Texture") then
				object.Transparency = state and 1 or 0

			end

		end

	end

	-- Toggle animation
	if state then

		tween(toggleCircle, {
			Position = UDim2.fromOffset(70, 7)
		}, 0.2):Play()

		tween(toggle, {
			BackgroundColor3 = Color3.fromRGB(70, 70, 78)
		}, 0.2):Play()

		toggleText.Text = "ON"

		statusText.Text = "Hidden"
		statusDescription.Text = "You are currently invisible."

		statusDot.BackgroundColor3 = Color3.fromRGB(220, 220, 225)

	else

		tween(toggleCircle, {
			Position = UDim2.fromOffset(7, 7)
		}, 0.2):Play()

		tween(toggle, {
			BackgroundColor3 = Color3.fromRGB(30, 30, 35)
		}, 0.2):Play()

		toggleText.Text = "OFF"

		statusText.Text = "Normal"
		statusDescription.Text = "You are not invisible."

		statusDot.BackgroundColor3 = Color3.fromRGB(165, 165, 175)

	end
end

toggle.MouseButton1Click:Connect(function()
	setInvisible(not invisible)
end)

