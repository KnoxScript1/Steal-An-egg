local function createSideButton(text, icon, y, selected)

	local btn = Instance.new("TextButton")
	btn.Size = UDim2.fromOffset(165, 52)
	btn.Position = UDim2.fromOffset(12, y)
	btn.BackgroundColor3 = selected and Color3.fromRGB(38, 38, 44)
		or Color3.fromRGB(12, 12, 15)
	btn.BackgroundTransparency = selected and 0 or 1
	btn.Text = ""
	btn.AutoButtonColor = false
	btn.Parent = sidebar

	corner(btn, 16)

	local iconLabel = Instance.new("TextLabel")
	iconLabel.Size = UDim2.fromOffset(40, 52)
	iconLabel.Position = UDim2.fromOffset(8, 0)
	iconLabel.BackgroundTransparency = 1
	iconLabel.Text = icon
	iconLabel.TextColor3 = selected and WHITE or SUBTEXT
	iconLabel.TextSize = 20
	iconLabel.Font = Enum.Font.Gotham
	iconLabel.Parent = btn

	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(1, -55, 1, 0)
	label.Position = UDim2.fromOffset(52, 0)
	label.BackgroundTransparency = 1
	label.Text = text
	label.TextColor3 = selected and TEXT or SUBTEXT
	label.TextSize = 15
	label.Font = Enum.Font.GothamMedium
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.Parent = btn

	btn.MouseEnter:Connect(function()
		if not selected then
			tween(btn, {
				BackgroundTransparency = 0,
				BackgroundColor3 = Color3.fromRGB(25, 25, 29)
			}, 0.15):Play()
		end
	end)

	btn.MouseLeave:Connect(function()
		if not selected then
			tween(btn, {
				BackgroundTransparency = 1
			}, 0.15):Play()
		end
	end)

	return btn
end

