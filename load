end

local function mkFrame(par, bg, sz, pos, zi, trans)
    local f = Instance.new("Frame", par)
    f.BackgroundColor3 = bg
    f.BorderSizePixel = 0
    f.Size = sz
    f.Position = pos or UDim2.new(0, 0, 0, 0)
    f.ZIndex = zi or 2
    if trans then
        f.BackgroundTransparency = trans
    end
    return f
end

